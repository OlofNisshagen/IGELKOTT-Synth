                                 .macro LOADY
                                 	ldi YL, low(@0)
                                 	ldi YH, high(@0)
                                 .endmacro
                                 
                                 .macro LOADZ
                                 	ldi ZL, low(@0 * 2)
                                 	ldi ZH, high(@0 * 2)
                                 .endmacro
                                 
                                 .macro ADDX
                                 	add XL, @0
                                 	adc XH, r2
                                 .endmacro
                                 
                                 .macro ADDIX
                                 	subi XL, -@0
                                 	adc XH, r2
                                 .endmacro
                                 
                                 .macro ADDY
                                 	add YL, @0
                                 	adc YH, r2
                                 .endmacro
                                 
                                 .macro ADDIY
                                 	subi YL, -@0
                                 	adc YH, r2
                                 .endmacro
                                 
                                 .macro ADDZ
