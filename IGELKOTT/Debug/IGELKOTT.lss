                                 TRIANGLE_WAVE:
0001ea 933f                      	push r19
0001eb fd37                          sbrc r19, 7     ; Is it the second half of the wave?
0001ec 9530                          com r19         ; If bit 7 is set, invert the value (creates the "down" slope)
0001ed 0f33                          lsl r19         ; Multiply by 2 to keep the amplitude full (0-255)
0001ee 9f31                          mul r19, r17    ; Scale by volume
0001ef 0d71                          add r23, r1     ; Add high byte to mixer
0001f0 913f                      	pop r19
0001f1 c000                      	rjmp WAVE_EXIT
                                 
