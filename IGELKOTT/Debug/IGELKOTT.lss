                                 SINE_WAVE:
000209 93ef                      	push ZL
00020a 93ff                      	push ZH
00020b ebee
00020c e0f1                      	loadz SINE_TABLE
00020d 0fe3
00020e 1df2                      	addz r19
00020f 9104                      	lpm r16, Z
000210 9f01                      	mul r16, r17
000211 0d71                      	add r23, r1
000212 91ff                      	pop ZH
000213 91ef                      	pop ZL
000214 c00e                      	rjmp WAVE_EXIT
                                 
                                 SQUARE_WAVE:
000215 fd37                      	sbrc r19, 7
000216 0f71                      	add r23, r17
000217 c00b                      	rjmp WAVE_EXIT
                                 
                                 SAWTOOTH_WAVE:
000218 9f31                      	mul r19, r17    ; Scale by volume
000219 0d71                          add r23, r1     ; Add high byte to mixer
00021a c008                      	rjmp WAVE_EXIT
                                 
                                 TRIANGLE_WAVE:
00021b 933f                      	push r19
00021c fd37                          sbrc r19, 7     ; Is it the second half of the wave?
00021d 9530                          com r19         ; If bit 7 is set, invert the value (creates the "down" slope)
00021e 0f33                          lsl r19         ; Multiply by 2 to keep the amplitude full (0-255)
00021f 9f31                          mul r19, r17    ; Scale by volume
000220 0d71                          add r23, r1     ; Add high byte to mixer
000221 913f                      	pop r19
000222 c000                      	rjmp WAVE_EXIT
                                 
